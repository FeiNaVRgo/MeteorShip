<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="normal_enemy">
    <Fallback>
      <Sequence>
        <LuaCondition parameters=""
                      script="scripts/lua/enemies/scout.lua"
                      bt_parameters="{bt_parameters}"
                      function="scout_has_target"
                      bt_context="{bt_context}"/>
        <LuaAction parameters=""
                   script="scripts/lua/enemies/scout.lua"
                   bt_parameters="{bt_parameters}"
                   function="scout_chase"
                   bt_context="{bt_context}"/>
      </Sequence>
      <LuaAction parameters=""
                 script="scripts/lua/enemies/scout.lua"
                 bt_parameters="{bt_parameters}"
                 function="scout_patrol"
                 bt_context="{bt_context}"/>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="LuaAction">
      <input_port name="parameters"
                  type="std::string">json:{}</input_port>
      <input_port name="script"
                  type="std::string"/>
      <input_port name="bt_parameters"
                  type="std::string"/>
      <input_port name="function"
                  type="std::string"/>
      <input_port name="bt_context"
                  type="ms::bt_nodes::BTContext"/>
    </Action>
    <Condition ID="LuaCondition">
      <input_port name="parameters"
                  type="std::string">json:{}</input_port>
      <input_port name="script"
                  type="std::string"/>
      <input_port name="bt_parameters"
                  type="std::string"/>
      <input_port name="function"
                  type="std::string"/>
      <input_port name="bt_context"
                  type="ms::bt_nodes::BTContext"/>
    </Condition>
  </TreeNodesModel>

</root>
