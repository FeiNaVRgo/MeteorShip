<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="normal_enemy">
    <Fallback>
      <Sequence>
        <LuaCondition script="scripts/lua/enemies/scout.lua"
                      function="scout_has_target"
                      parameters="json:{&quot;sight_range&quot;:300}"
                      bt_context="{bt_context}"/>
        <LuaAction script="scripts/lua/enemies/scout.lua"
                   function="scout_chase"
                   parameters="json:{&quot;speed&quot;:45}"
                   bt_context="{bt_context}"/>
      </Sequence>
      <LuaAction script="scripts/lua/enemies/scout.lua"
                 function="scout_patrol"
                 bt_context="{bt_context}"/>
    </Fallback>
  </BehaviorTree>

  <!-- Node models for Groot2 -->
  <TreeNodesModel>
    <Condition ID="LuaCondition">
      <input_port name="bt_context"
                  type="ms::bt_nodes::BTContext"/>
      <input_port name="script"
                  type="std::string"/>
      <input_port name="function"
                  type="std::string"/>
      <input_port name="parameters"
                  type="std::string"/>
    </Condition>
    <Action ID="LuaAction">
      <input_port name="bt_context"
                  type="ms::bt_nodes::BTContext"/>
      <input_port name="script"
                  type="std::string"/>
      <input_port name="function"
                  type="std::string"/>
      <input_port name="parameters"
                  type="std::string"/>
    </Action>
  </TreeNodesModel>

</root>
