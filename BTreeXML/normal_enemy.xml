<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="normal_enemy">
    <Sequence>
      <Fallback>
        <IsPlayerVisible player_visible="{player_visible}"
                         sight_range="300.0"
                         bt_context="{bt_context}"
                         game="{@game_ptr}"/>
        <ForceFailure>
          <RandomMovement bt_context="{bt_context}"
                          game="{@game_ptr}"/>
        </ForceFailure>
      </Fallback>
      <MoveForward speed="30"
                   bt_context="{bt_context}"/>
      <RotateTowards speed="60"
                     bt_context="{bt_context}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="IsPlayerVisible">
      <output_port name="player_visible"
                   type="bool"/>
      <input_port name="sight_range"
                  type="float"/>
      <input_port name="bt_context"
                  type="ms::bt_nodes::BTContext"/>
      <input_port name="game"
                  type="ms::Game*"/>
    </Condition>
    <Action ID="MoveForward">
      <input_port name="speed"
                  type="float"/>
      <input_port name="bt_context"
                  type="ms::bt_nodes::BTContext"/>
    </Action>
    <Action ID="RandomMovement">
      <input_port name="bt_context"
                  type="ms::bt_nodes::BTContext"/>
      <input_port name="game"
                  type="ms::Game*"/>
    </Action>
    <Action ID="RotateTowards">
      <input_port name="speed"
                  type="float"/>
      <input_port name="bt_context"
                  type="ms::bt_nodes::BTContext"/>
    </Action>
  </TreeNodesModel>

</root>
